---
import Mark from './Mark.astro';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links: NavLink[];
  cta?: NavLink;
  /** Set on an arm's page to render the "Kaaldarshi | Udant" lockup. */
  lockup?: string;
  current?: string;
}

const { links, cta, lockup, current } = Astro.props;
---

<header class="site-head">
  <div class="site-head__inner wrap">
    <p class="lockup">
      <a href="/" class:list={['home', lockup && 'home--muted']}>
        <Mark class="home__mark" />
        <span class="wordmark">Kaaldarshi</span>
      </a>
      {
        lockup && (
          <>
            <span class="lockup__bar" aria-hidden="true" />
            <span class="lockup__arm">{lockup}</span>
          </>
        )
      }
    </p>

    <nav class="site-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            class="nav-link"
            href={link.href}
            aria-current={current === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {
        cta && (
          <a class="btn btn--sm" href={cta.href}>
            {cta.label}
          </a>
        )
      }
    </nav>
  </div>
</header>

<style>
  .site-head {
    position: relative;
    z-index: 10;
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--hairline);
  }

  .site-head__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
    justify-content: space-between;
    padding-block: 22px;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .home {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding-block: 7px;
    text-decoration: none;
    color: var(--ink);
  }

  .home :global(.home__mark) {
    width: 34px;
    height: auto;
    flex: none;
    transition: color var(--quick) ease-out;
  }

  .home:hover :global(.home__mark) {
    color: var(--signal);
  }

  .wordmark,
  .lockup__arm {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .home--muted {
    color: var(--ink-3);
  }

  .home--muted:hover {
    color: var(--ink);
  }

  .lockup__bar {
    width: 1px;
    height: 14px;
    background: var(--hairline-bright);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    align-items: center;
  }

  /* Four links do not need a hamburger, but they do need to stop eating the
     first screen once they wrap. */
  @media (max-width: 620px) {
    .site-head__inner {
      gap: 14px 24px;
      padding-block: 16px;
    }

    .site-nav {
      gap: 12px 20px;
    }

    .home :global(.home__mark) {
      width: 28px;
    }

    .wordmark,
    .lockup__arm {
      font-size: 13px;
      letter-spacing: 0.18em;
    }
  }
</style>
