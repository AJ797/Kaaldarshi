---
/* A live band, because that is the right motif for this company — but it
   carries only true statements. No invented telemetry, no fake counters.
   The track holds two identical runs and travels -50%, so the loop is
   seamless; the duplicate is hidden from assistive tech. */

interface TickerItem {
  text: string;
  /** Transliterated Sanskrit, set in italic with its own lang. */
  translit?: boolean;
}

interface Props {
  items?: TickerItem[];
}

const {
  items = [
    { text: 'Kāladarśī', translit: true },
    { text: 'An information company' },
    { text: 'Information you can act on' },
    { text: 'Arm 01 · Udant' },
    { text: 'Arm 02 · K Research' },
    { text: 'Research, intelligence, software' },
  ],
} = Astro.props;
---

<div class="ticker">
  <div class="ticker__track">
    <div class="ticker__run">
      {
        items.map((item) => (
          <span class="ticker__item">
            {item.translit ? (
              <span class="translit" lang="sa-Latn">
                {item.text}
              </span>
            ) : (
              item.text
            )}
          </span>
        ))
      }
    </div>
    <div class="ticker__run" aria-hidden="true">
      {
        items.map((item) => (
          <span class="ticker__item">
            {item.translit ? (
              <span class="translit">{item.text}</span>
            ) : (
              item.text
            )}
          </span>
        ))
      }
    </div>
  </div>
</div>
