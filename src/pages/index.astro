---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ScrollRail from '../components/ScrollRail.astro';
import SectionRail from '../components/SectionRail.astro';
import ReadingStrip from '../components/ReadingStrip.astro';
import Ticker from '../components/Ticker.astro';
import { CONTACT_EMAIL } from '../lib/site';

const nav = [
  { href: '/#about', label: 'About' },
  { href: '/udant', label: 'Udant' },
  { href: '/k-research', label: 'K Research' },
];

const rail = [
  { id: 'top', label: 'Our business is information' },
  { id: 'about', label: 'About' },
  { id: 'arms', label: 'Arms' },
  { id: 'approach', label: 'Approach' },
];

/* Deliberately flat: four items, identical treatment, no featured entry.
   A reader should absorb "they do this everywhere", not "intelligence plus
   some other stuff". Do not turn this into a hero item plus three others. */
const domains = [
  'A corridor under pressure',
  'A codebase carrying a flaw nobody has found yet',
  'A market quietly repricing risk',
  'A terrain that has not been surveyed',
];

const udantPillars = [
  'Interrogate the model, with the evidence chain attached',
  'Standing monitors on entities, corridors, thresholds',
  'Seed a scenario, trace the cascade across domains',
  'Structured analysis, with the reasoning path exposed',
];

const researchAreas = [
  'Information theory',
  'Learning architectures',
  'Cognitive and metacognitive systems',
  'Multi-agent behaviour',
  'Applied mathematics and physics',
];

const approach = [
  'Answers carry their evidence and their limits. You should be able to check the work, and to see where it stops.',
  'We build for the person who has to act on the result, not file it.',
  'The theory underneath is open by default. Where something is withheld, we say that it is withheld.',
];
---

<Base
  title="Kaaldarshi — our product is information"
  description="Kaaldarshi is a problem-solving company. We build systems that work out what follows from what is already known: intelligence tooling, open research, and the software underneath both."
>
  <SiteHeader
    slot="header"
    links={nav}
    cta={{ href: '/#contact', label: 'Contact' }}
  />

  <ScrollRail items={rail} />

  <section id="top" class="hero">
    <div class="hero__field" aria-hidden="true"></div>

    <div class="hero__inner wrap">
      <p class="kicker">
        <span class="kicker__name">Kāladarśī</span>
        <span class="kicker__rule" aria-hidden="true"></span>
        <span class="label">An information company</span>
      </p>

      <h1 class="t-display hero__title">Our product is information.</h1>

      <p class="t-lede hero__lede">
        Information that aids decisions. We build systems that work out what a
        problem is telling you, and what to do about it.
      </p>

      <dl class="facts stagger">
        <div>
          <dt class="label">Arms</dt>
          <dd>02</dd>
        </div>
        <div>
          <dt class="label">Published work</dt>
          <dd>03</dd>
        </div>
        <div>
          <dt class="label">Building in</dt>
          <dd class="facts__wide">Research · Intelligence · Software</dd>
        </div>
      </dl>
    </div>
  </section>

  <Ticker />

  <section id="about" class="section about">
    <div class="wrap ruled railed reveal">
      <SectionRail index="02" label="About" />

      <div class="railed-body">
        <p class="t-body--ink">
          Kaaldarshi is a problem-solving company. Information is the material
          we work in.
        </p>

        <p class="t-body about__p">
          Most systems stop at reporting. They tell you what is there —
          accurately, in order, on time — and hand the hard part back to you.
          The hard part is what follows from it: what this state of affairs
          implies, what it rules out, and what is worth doing next.
        </p>

        <div class="terms">
          <div class="term">
            <span class="term__name">Reported</span>
            <span class="label term__gloss-label">
              <span class="translit" lang="sa-Latn">pratyakṣa</span>
            </span>
            <p class="term__gloss">What a system can observe directly.</p>
            <p class="term__foot">Where most tools stop</p>
          </div>

          <span class="terms__arrow" aria-hidden="true">
            <span class="terms__line"></span>
          </span>

          <div class="term term--signal">
            <span class="term__name">Inferred</span>
            <span class="label label--signal term__gloss-label">
              <span class="translit" lang="sa-Latn">anumāna</span>
            </span>
            <p class="term__gloss">What validly follows from it.</p>
            <p class="term__foot term__foot--signal">Where we work</p>
          </div>
        </div>

        <p class="t-body about__p">
          That second step is the same job in every domain we have looked at.
        </p>

        <ul class="domains stagger">
          {
            domains.map((domain, i) => (
              <li>
                <span class="mono domains__num">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="domains__text">{domain}</span>
              </li>
            ))
          }
        </ul>

        <p class="t-body about__p">
          One question wearing different clothes: what does the present state
          of this system tell you about its next one? The material changes. The
          machinery underneath barely does.
        </p>

        <p class="t-body about__p--tight">
          So we build wherever that question is worth asking. Udant is the
          first of those — intelligence tooling for analysts. K Research is
          where the theory underneath gets worked out, published openly
          wherever the work allows it. Financial systems come next, then
          broader software. The list is not meant to be finished.
        </p>
      </div>
    </div>
  </section>

  <section id="arms" class="section">
    <div class="wrap ruled reveal">
      <div class="heads">
        <span class="label">03 — Arms</span>
        <h2 class="t-h2">Where the question is being asked right now.</h2>
      </div>

      <div class="arms">
        <article class="panel arm">
          <div class="arm__head">
            <span class="label">Arm 01</span>
            <span class="label label--signal">Platform</span>
          </div>

          <h3 class="t-h3">Udant</h3>
          <p class="arm__line">
            Institutional intelligence tooling, built for analysts.
          </p>
          <p class="arm__body">
            A live structured model of entities, corridors, institutions and
            events — open to interrogation. You bring the questions. You decide
            what matters.
          </p>

          <ul class="rows arm__rows">
            {
              udantPillars.map((pillar, i) => (
                <li class="row-ab">
                  <span class="mono">{String.fromCharCode(65 + i)}</span>
                  <span>{pillar}</span>
                </li>
              ))
            }
          </ul>

          <div class="arm__strip">
            <ReadingStrip
              label="Chokepoint reading vs. own baseline"
              fill={58}
              base={44}
              note="Illustrative surface — no live data on this page"
            />
          </div>

          <p class="arm__cta">
            <a class="btn" href="/udant">
              Open Udant <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </article>

        <article class="panel arm arm--paper ground-paper">
          <div class="arm__head">
            <span class="label">Arm 02</span>
            <span class="label">Research</span>
          </div>

          <h3 class="t-h3">K Research</h3>
          <p class="arm__line">The research arm of Kaaldarshi.</p>
          <p class="arm__body">
            Where the theory behind our systems gets worked out. Published
            openly wherever the work allows it. Not everything will be, but the
            default is open.
          </p>

          <ul class="rows arm__rows">
            {researchAreas.map((area) => <li class="arm__area">{area}</li>)}
          </ul>

          <div class="arm__foot">
            <span class="label">03 papers out · TMLR and preprint</span>
            <p class="arm__cta">
              <a class="btn" href="/k-research">
                Open K Research
                <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="approach" class="section">
    <div class="wrap ruled reveal standard">
      <span class="label standard__index">04 — Approach</span>

      <p class="t-statement standard__claim">
        We would rather solve the problem than describe it.
      </p>

      <div class="standard__cols stagger">
        {approach.map((line) => <p class="t-small">{line}</p>)}
      </div>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="wrap panel contact reveal">
      <div class="contact__body">
        <h2 class="t-h4">
          If the question is being asked in your domain, we want to hear it.
        </h2>
        <p class="contact__note">
          For Udant access, <a class="link-ink" href="/udant">go here</a>. For
          research, collaboration or anything else, write to us directly.
        </p>
      </div>

      <div class="contact__direct">
        <span class="label">Direct</span>
        <a class="contact__email" href={`mailto:${CONTACT_EMAIL}`}>
          {CONTACT_EMAIL}
        </a>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</Base>

<style>
  .hero__title {
    max-width: 13ch;
  }

  .hero__lede {
    margin-block-start: 36px;
    max-width: 50ch;
  }

  .facts__wide {
    font-size: 14px;
  }

  .about__p {
    margin-block-start: 28px;
  }

  .about__p--tight {
    margin-block-start: 22px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-2);
    max-width: 68ch;
  }

  /* --- reported / inferred ------------------------------------------------
     English carries the idea; the Sanskrit sits underneath as provenance,
     not as the headline. Reversing those two makes the section read as being
     about the name rather than about the work. */

  .terms {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 16px;
    margin-block-start: 44px;
  }

  .term {
    flex: 1 1 260px;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: 26px;
    transition: border-color var(--quick) ease-out;
  }

  .term--signal {
    background: var(--surface-raised);
    border-left: 1px solid var(--signal);
  }

  .term__name {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.028em;
    color: var(--ink-3);
  }

  .term--signal .term__name {
    color: var(--ink);
  }

  .term__gloss-label {
    margin-block-start: 10px;
  }

  .term__gloss {
    margin-block-start: 16px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
  }

  .term__foot {
    margin-block-start: 20px;
    padding-block-start: 14px;
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--ink-label);
  }

  .term__foot--signal {
    color: var(--signal-ink);
  }

  .terms__arrow {
    flex: 0 0 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .terms__line {
    width: 100%;
    height: 1px;
    background: var(--hairline-bright);
    transform-origin: left;
  }

  :global(.js) .reveal .terms__line {
    transform: scaleX(0);
    transition: transform var(--enter) var(--ease) 200ms;
  }

  :global(.js) .reveal.is-in .terms__line {
    transform: scaleX(1);
  }

  @media (max-width: 620px) {
    .terms__arrow {
      flex: 1 1 100%;
      height: 12px;
    }
  }

  /* --- the flat domain list ----------------------------------------------- */

  .domains {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px;
    margin-block-start: 28px;
  }

  .domains li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid var(--hairline);
    padding-block-start: 16px;
  }

  .domains__num {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--ink-label);
  }

  .domains__text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
  }

  /* --- arms --------------------------------------------------------------- */

  .arms {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .arm {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    transition: border-color var(--t-200) ease-out;
  }

  .arm:hover {
    border-color: var(--hairline-bright);
  }

  .arm--paper {
    flex: 1 1 380px;
    background: var(--ground);
    border-color: var(--hairline);
    color: var(--ink);
  }

  .arm__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-block-end: 48px;
  }

  .arm__line {
    margin-block-start: 20px;
    max-width: 34ch;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink);
  }

  .arm__body {
    margin-block-start: 20px;
    max-width: 48ch;
    font-size: 15px;
    line-height: 1.68;
    color: var(--ink-2);
  }

  .arm__rows {
    margin-block-start: 40px;
  }

  .arm__area {
    padding-block: 13px;
    font-size: 14px;
    color: var(--ink);
  }

  .arm__strip {
    margin-block-start: 36px;
  }

  .arm__cta {
    margin-block-start: 40px;
  }

  .arm__foot {
    margin-block-start: auto;
    padding-block-start: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  .arm__foot .arm__cta {
    margin-block-start: 0;
  }

  /* --- approach: no rail, the claim carries the section ------------------- */

  .standard__index {
    margin-block-end: 40px;
  }

  .standard__claim {
    max-width: 20ch;
  }

  .standard__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
    margin-block-start: clamp(48px, 6vw, 80px);
    padding-block-start: 28px;
    border-top: 1px solid var(--hairline);
  }

  .standard__cols p {
    line-height: 1.7;
    color: var(--ink-2);
  }

  /* --- contact ------------------------------------------------------------ */

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-end;
    padding: clamp(32px, 4vw, 64px);
  }

  .contact__body {
    flex: 999 1 420px;
    min-width: 0;
  }

  .contact__body h2 {
    max-width: 24ch;
  }

  .contact__note {
    margin-block-start: 18px;
    max-width: 52ch;
    color: var(--ink-2);
  }

  .contact__direct {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .contact__email {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: clamp(15px, 1.5vw, 18px);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-bright);
    padding-block: 6px 4px;
    transition: border-color var(--quick) ease-out;
  }

  .contact__email:hover {
    border-color: var(--signal);
  }
</style>
